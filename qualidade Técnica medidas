JUSTIFICATIVA = 'tbl oc'[FALHA]&" / "& 'tbl oc'[CAUSA]
-------------------------------------------------------------
ID Ocorrência Anterior 30d = 
VAR IdentificadorAtual = 'tbl oc'[IDENTIFICADOR]
VAR DataAtual = INT('tbl oc'[DATA])
VAR IdAtual = 'tbl oc'[ID_OCORRENCIA]
 
VAR LinhaAnterior =
    TOPN(
        1,
        FILTER(
            ALL('tbl oc'),
            'tbl oc'[IDENTIFICADOR] = IdentificadorAtual
                && INT('tbl oc'[DATA]) < DataAtual
                && INT('tbl oc'[DATA]) >= DataAtual - 30
                && 'tbl oc'[ID_OCORRENCIA] <> IdAtual
        ),
        'tbl oc'[DATA], DESC,
        'tbl oc'[ID_OCORRENCIA], DESC
    )
 
VAR IdAnterior =
    MAXX(LinhaAnterior, 'tbl oc'[ID_OCORRENCIA])
 
VAR FuncAnterior =
    MAXX(LinhaAnterior, 'tbl oc'[FUNCIONARIO])
 
VAR CausaAnterior =
    MAXX(LinhaAnterior, 'tbl oc'[CAUSA])
 
VAR FuncTratado = TRIM(COALESCE(FuncAnterior, ""))
VAR CausaTratada = UPPER(TRIM(COALESCE(CausaAnterior, "")))
 
RETURN
IF(
    CausaTratada = "ONT ROGUE"
        || FuncTratado = "",
    BLANK(),
    IdAnterior
)
