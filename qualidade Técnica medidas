AGING 24H = 
VAR h = 'tbl oc'[HORAS CORRIDAS]   -- horas em decimal
RETURN
SWITCH (
    TRUE(),
    ISBLANK(h),                "Sem dados",
    h < 3,                     "0 a 3h",
    h < 5,                     "3 a 5h",
    h < 8,                     "5 a 8h",
    h < 12,                    "8 a 12h",
    h < 24,                    "12 a 24h",
                                ">24h"
)
