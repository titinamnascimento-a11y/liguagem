_UltimoMesRealFechado = 
EOMONTH ( TODAY(), -1 )
--------------------------------------------------------------------------
OCS Projeção (Curva Balanceada) = 
VAR Peso = [Peso Tendência]
RETURN
    [OCS Projeção (Polinomial ancorada dinâmica)] * Peso
    + [OCS Tendência Real Dinâmica] * (1 - Peso)
------------------------------------------------------------------------
OCS Projeção (mês atual apenas) = 
VAR MesCtx   = EOMONTH ( [_MesDataContexto], 0 )
VAR MesAtual = EOMONTH ( TODAY(), 0 )
RETURN
IF ( MesCtx = MesAtual, [Projecao_Final SG], BLANK() )
-------------------------------------------------------------------------------OCS Projeção (Polinomial ancorada dinâmica) = 
VAR DataCtx = [_MesDataContexto]
VAR InicioProjecao = EDATE ( [_UltimoMesRealFechado], 1 )

VAR x =
    DATEDIFF ( DATE ( 2024, 1, 1 ), DataCtx, MONTH ) + 1

VAR y_base =
    15.75472897 * ( x ^ 2 )
    - 185.25712874 * x
    + 7477.62987013

VAR UltimoMesReal = [_UltimoMesRealFechado]

VAR x_ancora =
    DATEDIFF (
        DATE ( 2024, 1, 1 ),
        DATE ( YEAR ( UltimoMesReal ), MONTH ( UltimoMesReal ), 1 ),
        MONTH
    ) + 1

VAR y_base_ancora =
    15.75472897 * ( x_ancora ^ 2 )
    - 185.25712874 * x_ancora
    + 7477.62987013

VAR y_real_ancora =
    CALCULATE(
        [oc],
        FILTER(
            ALL ( Dim_Calendario ),
            EOMONTH ( Dim_Calendario[Data], 0 ) = UltimoMesReal
        )
    )

VAR delta = y_real_ancora - y_base_ancora
VAR y = ROUND ( y_base + delta, 0 )

RETURN
IF (
    DataCtx >= InicioProjecao,
    y,
    BLANK()
)
