_MesDataContexto = 
VAR d  = MAX ( Dim_Calendario[Data] )
VAR am = SELECTEDVALUE ( Dim_Calendario[Data])
VAR d_am =
    IF (
        NOT ISBLANK ( am ),
        DATE ( INT ( am / 100 ), MOD ( am, 100 ), 1 )
    )
RETURN
COALESCE ( d, d_am )

