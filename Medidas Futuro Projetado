OCS Tendência Real Dinâmica = 
VAR DataCtx = [_MesDataContexto]
VAR MesCtx  = DATE ( YEAR ( DataCtx ), MONTH ( DataCtx ), 1 )

VAR UltimoMesFechado =
    DATE ( YEAR ( EOMONTH ( TODAY(), -1 ) ), MONTH ( EOMONTH ( TODAY(), -1 ) ), 1 )

VAR InicioJanela =
    EDATE ( UltimoMesFechado, -5 )   -- últimos 6 meses contando o último fechado

VAR TabelaMeses =
    ADDCOLUMNS(
        FILTER(
            ALL ( Dim_Calendario ),
            Dim_Calendario[Data] >= InicioJanela
                && Dim_Calendario[Data] <= UltimoMesFechado
                && DAY ( Dim_Calendario[Data] ) = 1
        ),
        "X", DATEDIFF ( InicioJanela, Dim_Calendario[Data], MONTH ) + 1,
        "Y",
            CALCULATE(
                [oc],
                FILTER(
                    ALL ( Dim_Calendario ),
                    YEAR ( Dim_Calendario[Data] ) = YEAR ( EARLIER ( Dim_Calendario[Data] ) )
                        && MONTH ( Dim_Calendario[Data] ) = MONTH ( EARLIER ( Dim_Calendario[Data] ) )
                )
            )
    )

VAR MediaX = AVERAGEX ( TabelaMeses, [X] )
VAR MediaY = AVERAGEX ( TabelaMeses, [Y] )

VAR Numerador =
    SUMX(
        TabelaMeses,
        ([X] - MediaX) * ([Y] - MediaY)
    )

VAR Denominador =
    SUMX(
        TabelaMeses,
        ([X] - MediaX) ^ 2
    )

VAR Inclinacao = DIVIDE ( Numerador, Denominador )
VAR Intercepto = MediaY - ( Inclinacao * MediaX )

VAR XAtual =
    DATEDIFF ( InicioJanela, MesCtx, MONTH ) + 1

VAR YProjetado =
    ROUND ( Intercepto + ( Inclinacao * XAtual ), 0 )

RETURN
IF (
    MesCtx >= DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
        && MesCtx <= DATE ( YEAR ( TODAY() ), 12, 1 ),
    YProjetado,
    BLANK()
)
